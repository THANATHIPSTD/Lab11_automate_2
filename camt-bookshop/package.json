{
  "name": "camt-bookshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Week 13 Lab 2 (build your own CI/CD pipeline) - Nuxt starter repository",
  "scripts": {
    "dev": "nuxt dev --port 3000",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "report": "playwright show-report"
  },
  "dependencies": {
    "nuxt": "^4.5.2",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.3.12"
  }
}
